# CogniVista 观睿 — 大模型环境变量示例
# 全部可选：不配置任何 Key 时系统自动启用内置高保真学术演示数据集（Demo Fallback）。
# 复制本文件为 .env.local 并按需填写；前端右上角也支持在线热配置 Key（仅存于浏览器本地）。

# API Key（DeepSeek 官方或任意 OpenAI 兼容服务，如阿里云百炼）
DEEPSEEK_API_KEY=

# OpenAI 兼容接口地址（默认 https://api.deepseek.com）
LLM_BASE_URL=

# 对话 / 结构化输出模型（默认 deepseek-chat）
LLM_CHAT_MODEL=

# 推理模型（默认依次回落到 LLM_CHAT_MODEL / deepseek-reasoner）
LLM_REASONER_MODEL=

# 思维链开关：qwen3.x 等思考模型建议设为 false，
# 避免长思维链击穿 90s 客户端超时（不设置则不下发该参数，保持 DeepSeek 行为不变）
LLM_ENABLE_THINKING=
